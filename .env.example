# Copy to `.env.local` (local) or set in Vercel (production). Never commit real secrets.
# Local dev: `npx supabase start`, then `npx supabase status -o env` for these values.
# Production: Supabase dashboard > Project Settings > API Keys (the new keys, not the legacy anon/service_role JWTs).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (sb_publishable_...). Safe in the browser; Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Secret key (sb_secret_...). SERVER ONLY, never use a NEXT_PUBLIC_ prefix. Bypasses RLS; used only for
# login username lookup, signup uniqueness check and account deletion.
SUPABASE_SECRET_KEY=sb_secret_xxx
