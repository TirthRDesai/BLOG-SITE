# Example environment variables for the project
# Copy this file to `.env` and fill real values (DO NOT commit secrets).

# AES key used by client/server encryption (keep secret)
NEXT_PUBLIC_KEY=your_aes_key_here

# Supabase public URL and anon key (used by client-side supabase client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key_here

# Optional: Public base URL for the app (used for redirects/callbacks)
# NEXT_PUBLIC_BASE_URL=http://localhost:3000

# NOTES:
# - Keep real secret values only in a non-committed `.env` file.
# - Prefix `NEXT_PUBLIC_` exposes values to the browser; don't put sensitive secrets there.
# - If you add server-only secrets (DB connection strings, JWT secrets, etc.),
#   add them here without `NEXT_PUBLIC_` and keep them out of version control.
