# Copy to `.env` and fill in real values. Never commit secrets.

# Supabase project (public URL + anon key are safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key_here

# SERVER-ONLY (no NEXT_PUBLIC_ prefix). API routes use this to talk to Supabase
# after checking the logged-in user themselves. Then enable RLS on all tables
# with NO anon policies so the public anon key can no longer touch your data.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# SERVER-ONLY. Signs session cookies. Generate with: openssl rand -base64 48
SESSION_SECRET=replace_with_at_least_32_random_characters

# Legacy: only obfuscates JSON between client and server. It is NOT security
# (NEXT_PUBLIC_ values ship to the browser). Safe to remove in a later cleanup.
NEXT_PUBLIC_KEY=any_string
