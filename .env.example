# Copy to `.env.local` (local) or set in Vercel (production). Never commit real secrets.
# For local dev run `npx supabase start` then `npx supabase status -o env` for these values.

# Public: safe in the browser. Row Level Security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# SERVER ONLY (no NEXT_PUBLIC_ prefix). Bypasses RLS. Used only for login username lookup,
# signup uniqueness check and account deletion.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
